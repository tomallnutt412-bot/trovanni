// Static-assets Worker config for trovanni.co.uk. Production (main): `npx wrangler deploy`.
// Branch previews: `npx wrangler preview` / `versions upload` (needs the empty "previews" block).
// Internal files are excluded from serving via .assetsignore.
{
  "name": "trovanni",
  "compatibility_date": "2026-04-01",
  "assets": { "directory": "." },
  "previews": {}
}
